{
  "manifest_version": 3,
  "name": "OdioFile",
  "version": "1.9.1",
  "description": "Build chaptered audiobook bundles (merged MP3, chapters CSV and cover) from the audiobook page you are listening to.",
  "permissions": ["scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "OdioFile",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Open OdioFile"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["buffer.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
